# Clave secreta para firmar las cookies de sesion (requerida)
# Genera una clave larga y aleatoria, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Configuracion SMTP para el envio de correos (reset de contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Auditoria de metodos (opcional, false por defecto)
ENABLE_AUDIT=false
